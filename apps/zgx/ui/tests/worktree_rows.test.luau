-- Worktree mode: the sidebar lists one row per worktree, the header's tabs are that
-- worktree's open chats, and its closed ones come back from the history menu. On the
-- shell in ui/shell_fixture.luau.

local SIDE = "#shell-sidebar"

local function eventually(app: any, ok: () -> boolean): boolean
	for _ = 1, 60 do
		if ok() then
			return true
		end
		app:frames(10)
	end
	return ok()
end

local function new_here(app: any)
	app:click("#session-tabs-new")
	app:frames(20)
	app:click('role:menuitem "New chat"')
	app:frames(30)
end

local function open(): any
	local app = mount("shell_fixture.luau")
	app:resize(1200, 800)
	app:set_state("shell_fixture.worktrees", true)
	app:frames(30)
	app:command("worktrees")
	app:frames(30)
	return app
end

local function row(app: any, title: string): boolean
	return app:has(`{SIDE} >> role:button "{title}"`)
end

test("a worktree's chats are one row, named for its first chat", function()
	local app = open()
	expect(row(app, "Write the docs")).to_be(true)
	expect(row(app, "Fix the build")).to_be(false)
	expect(row(app, "Tidy the tests")).to_be(false)
	expect(row(app, "Ship the release")).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("a chat given a workspace of its own is a row of its own, in the same checkout", function()
	local app = open()
	expect(row(app, "Fix the build")).to_be(false)
	app:set_state("shell_workspace_of", { a1 = "w1" })
	app:frames(30)
	expect(row(app, "Fix the build")).to_be(true)
	expect(row(app, "Write the docs")).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("its row opens the chat last active there, as a tab of its own", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	expect(app:has("#session-tab-a1")).to_be(true)
	expect(app:has("#session-tab-a2")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("a closed chat of the worktree comes back from the history menu", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click("#session-tabs-history")
	app:frames(20)
	expect(app:wait('"Write the docs"', { timeout_ms = 5000 })).to_be(true)
	app:click('role:menuitem "Write the docs"')
	app:frames(30)
	expect(app:has("#session-tab-a2")).to_be(true)
	expect(app:has("#session-tab-a1")).to_be(true)
	expect(app:error()).to_be_nil()
end)

local function panel_open(app: any): boolean
	local line = app:tree("#shell-files"):match("[^\n]+") or ""
	return not line:find(" hidden", 1, true) and not line:find(" 0x", 1, true)
end

test("the panel is the worktree's: open beside one chat, it's open beside the other", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	expect(panel_open(app)).to_be(false)
	app:click('role:button "Panel"')
	app:frames(60)
	expect(panel_open(app)).to_be(true)
	app:click("#session-tabs-history")
	app:frames(20)
	app:click('role:menuitem "Write the docs"')
	app:frames(60)
	expect(app:has("#session-tab-a2")).to_be(true)
	expect(panel_open(app)).to_be(true)
	app:click(`{SIDE} >> role:button "Ship the release"`)
	app:frames(60)
	expect(panel_open(app)).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("another worktree's tabs stand aside", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click(`{SIDE} >> role:button "Ship the release"`)
	app:frames(30)
	expect(app:has("#session-tab-b1")).to_be(true)
	expect(app:has("#session-tab-a1")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("the header's + starts a chat in the worktree showing, in its folder", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	new_here(app)
	local pinned = app:state("screens/shell/route.luau::shell_pinned_worktree") :: any
	expect(pinned).never.to_be_nil()
	expect(pinned.cwd).to_be("/Users/me/.naive/worktrees/atlas/quick-fox")
	expect(pinned.branch).to_be("naive/quick-fox")
	expect(app:error()).to_be_nil()
end)

test("the Activity view ranks worktrees, not chats", function()
	local app = mount("shell_fixture.luau")
	app:resize(1200, 800)
	app:set_state("screens/shell/activity.luau::shell_sidebar_activity", true)
	app:set_state("shell_fixture.worktrees", true)
	app:frames(30)
	app:command("worktrees")
	app:frames(30)
	expect(row(app, "Ship the release")).to_be(true)
	expect(row(app, "Answer the review")).to_be(false)
	expect(row(app, "Fix the build")).to_be(false)
	expect(row(app, "Tidy the tests")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("New chat starts a row of its own; the header's + stays in the workspace", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	new_here(app)
	expect(app:state("chat_checkout")).to_be("local")
	expect(app:state("chat_branch")).to_be("naive/quick-fox")
	expect(app:state("shell_workspace_pick")).to_be_nil()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click(`{SIDE} >> role:button "New chat"`)
	app:frames(30)
	expect(app:state("shell_workspace_pick")).never.to_be_nil()
	expect(app:error()).to_be_nil()
end)

test("a new chat in the worktree shows as its tab at once, and stays until put away", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(false)
	new_here(app)
	expect(app:has("#session-tab-draft")).to_be(true)
	local function x_of(sel: string): (number, number)
		local x, w = app:tree(sel):match(" (%-?[%d%.]+),%-?[%d%.]+ ([%d%.]+)x")
		return tonumber(x) :: number, tonumber(w) :: number
	end
	local tab_x, tab_w = x_of("#session-tab-a1")
	local draft_x = x_of("#session-tab-draft")
	expect(draft_x > tab_x and draft_x < tab_x + tab_w + 24).to_be(true)
	app:click("#session-tab-a1")
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(true)
	app:click("#session-tab-draft")
	app:frames(30)
	expect(app:state("chat_branch")).to_be("naive/quick-fox")
	app:click('#session-tab-draft >> role:button "Discard new chat"')
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(false)
	expect(app:has("#session-tab-a1")).to_be(true)
	app:click(`{SIDE} >> role:button "Ship the release"`)
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("⌘W closes the chat's tab, the panel open beside it or not", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click("#session-tabs-history")
	app:frames(20)
	app:click('role:menuitem "Write the docs"')
	app:frames(30)
	app:click('role:button "Panel"')
	app:frames(60)
	expect(app:has("#session-tab-a2")).to_be(true)
	app:command("shell.close")
	app:frames(30)
	expect(app:has("#session-tab-a2")).to_be(false)
	expect(app:has("#session-tab-a1")).to_be(true)
	new_here(app)
	expect(app:has("#session-tab-draft")).to_be(true)
	app:command("shell.close")
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(false)
	expect(app:error()).to_be_nil()
end)

test("⌘T is another chat in the workspace showing; ⌘N starts a workspace of its own", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:command("shell.new_tab")
	app:frames(30)
	expect(app:state("chat_checkout")).to_be("local")
	expect(app:state("chat_branch")).to_be("naive/quick-fox")
	expect(app:has("#session-tab-draft")).to_be(true)
	expect(app:state("shell_workspace_pick")).to_be_nil()
	app:click("#session-tab-a1")
	app:frames(30)
	app:command("shell.new_chat")
	app:frames(30)
	expect(app:has("#session-tab-draft")).to_be(false)
	expect(app:state("shell_workspace_pick")).never.to_be_nil()
	expect(app:error()).to_be_nil()
end)

test("the history button stands beside the panel's toggle, past the tabs", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	local function box(sel: string): (number, number)
		local x, w = app:tree(sel):match(" (%-?[%d%.]+),%-?[%d%.]+ ([%d%.]+)x")
		return tonumber(x) :: number, tonumber(w) :: number
	end
	local hx, hw = box("#session-tabs-history")
	local px = box('role:button "Panel"')
	local nx = box("#session-tabs-new")
	expect(hx > nx).to_be(true)
	expect(px - (hx + hw) < 40).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("the header's + lists the installed terminal agents under a divider", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click("#session-tabs-new")
	app:frames(20)
	expect(app:wait('role:menuitem "New chat"', { timeout_ms = 5000 })).to_be(true)
	expect(app:has('role:menuitem "Claude Code"')).to_be(true)
	expect(app:has('role:menuitem "Codex"')).to_be(true)
	expect(app:has('role:menuitem "Amp"')).to_be(false)
	expect(app:error()).to_be_nil()
end)

local function start_claude(app: any): string
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click("#session-tabs-new")
	app:frames(20)
	app:click('role:menuitem "Claude Code"')
	app:frames(60)
	local open_list = app:state("screens/shell/terminal_agents.luau::terminal_agents_open") :: any
	return open_list[1].id
end

test("a terminal agent opens as a tab of the worktree, its CLI typed in", function()
	local app = open()
	local id = start_claude(app)
	expect(app:has(`#session-tab-{id}`)).to_be(true)
	expect(app:has("#session-tab-a1")).to_be(true)
	expect(app:has(`#terminal-agent-{id}`)).to_be(true)
	expect(eventually(app, function()
		return string.find(app:state("fixture_term_writes") or "", "claude\r", 1, true) ~= nil
	end)).to_be(true)
	local open_list = app:state("screens/shell/terminal_agents.luau::terminal_agents_open") :: any
	expect(open_list[1].cwd).to_be("/Users/me/.naive/worktrees/atlas/quick-fox")
	expect(app:error()).to_be_nil()
end)

test("a terminal agent at work shows as working", function()
	local app = open()
	local id = start_claude(app)
	app:set_state("fixture_term_busy", true)
	expect(eventually(app, function()
		local s = app:state("screens/shell/terminal_agents.luau::terminal_agents_status") :: any
		return s ~= nil and s[id] == "working"
	end)).to_be(true)
	app:set_state("fixture_term_busy", false)
	expect(eventually(app, function()
		local s = app:state("screens/shell/terminal_agents.luau::terminal_agents_status") :: any
		return s == nil or s[id] == nil
	end)).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("closing a terminal agent's tab ends it", function()
	local app = open()
	local id = start_claude(app)
	app:command("shell.close")
	app:frames(30)
	expect(app:has(`#session-tab-{id}`)).to_be(false)
	local open_list = app:state("screens/shell/terminal_agents.luau::terminal_agents_open") :: any
	expect(#open_list).to_be(0)
	expect(app:error()).to_be_nil()
end)

test("the panel stands aside while settings shows, and comes back after", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	app:click('role:button "Panel"')
	app:frames(60)
	expect(panel_open(app)).to_be(true)
	app:command("shell.settings")
	app:frames(60)
	expect(panel_open(app)).to_be(false)
	app:click('"Back to chats"')
	app:frames(60)
	expect(panel_open(app)).to_be(true)
	expect(app:error()).to_be_nil()
end)

test("a new chat sent with a terminal agent picked starts it there, the prompt passed", function()
	local app = open()
	app:click(`{SIDE} >> role:button "Write the docs"`)
	app:frames(30)
	new_here(app)
	app:set_state("chat_model", "terminal/claude")
	app:frames(10)
	app:type('role:textbox "Message"', "fix the build's tests")
	app:key("Enter")
	app:frames(60)
	local open_list = app:state("screens/shell/terminal_agents.luau::terminal_agents_open") :: any
	expect(#open_list).to_be(1)
	expect(open_list[1].agent).to_be("claude")
	expect(open_list[1].cwd).to_be("/Users/me/.naive/worktrees/atlas/quick-fox")
	expect(eventually(app, function()
		return string.find(app:state("fixture_term_writes") or "", "claude 'fix the build'\\''s tests'\r", 1, true) ~= nil
	end)).to_be(true)
	expect(app:has(`#terminal-agent-{open_list[1].id}`)).to_be(true)
	expect(app:error()).to_be_nil()
end)
